# Public application base URL (used for origin checks)
APP_URL="MY_APP_URL"

# Server-only session signing secret (required in production, >= 32 characters)
SESSION_SECRET=""

# Cookie cross-site mode ("true" or "1" only when embedded inside a third-party iframe over HTTPS)
COOKIE_CROSS_SITE="false"

# Managed PostgreSQL connection string for persistent production storage (optional locally; falls back to DB_PATH SQLite)
# On Cloud Run, use the provider's IPv4 connection pooler address rather than an IPv6-only direct host.
DATABASE_URL=""
PGSSL="0"
PG_CA_CERT=""

# Local SQLite database path used when DATABASE_URL is not set
DB_PATH="./data/crystalkoi.sqlite"

# Optional email notification & OTP delivery settings (server-only)
NOTIFY_EMAIL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_ALLOW_PLAINTEXT="0"

# Optional Google Identity OAuth client ID (public client ID; server verifies aud, iss, exp)
GOOGLE_CLIENT_ID=""
